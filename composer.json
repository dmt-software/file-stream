{
  "name": "dmt-software/file-stream",
  "type": "library",
  "license": "MIT",
  "description": "Import and export large datasets with a low memory footprint.",
  "keywords": [
    "import",
    "export",
    "file-stream",
    "csv",
    "json",
    "xml",
    "reader",
    "writer",
    "serialization"
  ],
  "authors": [
    {
      "name": "Bas de Mes",
      "email": "bas@dmt-software.nl"
    }
  ],
  "autoload": {
    "psr-4": {
      "DMT\\FileStream\\": "src/"
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*",
    "ext-xmlreader": "*",
    "ext-xmlwriter": "*",
    "pcrov/jsonreader": "^1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "DMT\\Test\\FileStream\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "symfony/expression-language": "^8.1"
  },
  "scripts": {
    "test": "phpunit --group default --group integration"
  },
  "suggest": {
    "symfony/expression-language": "For using expressions in filters"
  }
}
